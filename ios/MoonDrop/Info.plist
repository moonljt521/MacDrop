<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>MoonDrop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!--
	  图标走「散装 PNG」而不是资源目录：
	  actool 编译含设备 idiom 的图标集时，要连带把模拟器平台一起裁剪，
	  因此强制要求本机装过模拟器 runtime（actool 会直接报
	  "No available simulator runtimes for platform iphonesimulator"）。
	  这里改成 AppIcon.appiconset 只留 1024 的 marketing 图标（actool 能编），
	  设备尺寸的 PNG 以普通资源打包，用 CFBundleIconFiles 声明，效果一致。
	-->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60@2x</string>
				<string>AppIcon60x60@3x</string>
				<string>AppIcon76x76@1x</string>
				<string>AppIcon76x76@2x</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<false/>
		</dict>
	</dict>
	<key>CFBundleIconFiles</key>
	<array>
		<string>AppIcon60x60@2x</string>
		<string>AppIcon60x60@3x</string>
		<string>AppIcon76x76@1x</string>
		<string>AppIcon76x76@2x</string>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>任何文件</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.macdrop.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moondrop</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_macdrop._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MoonDrop 需要在局域网内发现其他 Mac / iPhone / Android，并直接传输文件。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于显示当前连接的 Wi-Fi 名称，方便你确认两台设备在同一个网络。不会记录或上传任何位置信息。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MoonDrop 需要写入相册，才能把收到的照片和视频保存下来。</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
